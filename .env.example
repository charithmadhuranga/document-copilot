# ========================
# Provider selection
# ========================
# LLM_PROVIDER: openai | gemini | anthropic | openrouter | nvidia | ollama
#              lm_studio | huggingface | groq | mistral | cohere | xai | cerebras | bedrock
#
# IMPORTANT: LLM and embedding providers are fully decoupled.
# Set EMBEDDING_PROVIDER to use a different provider for embeddings than for the LLM.
# This lets you pair LLMs without embedding APIs (Anthropic, Groq, xAI, Cerebras)
# with any embedding provider that has one (OpenAI, Gemini, Cohere, etc.).
#
# Examples:
#   LLM_PROVIDER=anthropic + EMBEDDING_PROVIDER=openai    (Anthropic LLM + OpenAI embeddings)
#   LLM_PROVIDER=groq     + EMBEDDING_PROVIDER=gemini     (Groq LLM + Gemini embeddings)
#   LLM_PROVIDER=openai   + EMBEDDING_PROVIDER=cohere     (OpenAI LLM + Cohere embeddings)
#   LLM_PROVIDER=openai                                    (same provider for both)
LLM_PROVIDER=openai

# Embedding provider (defaults to LLM_PROVIDER if empty)
# openai | gemini | cohere | voyageai | sentence_transformers | bedrock | huggingface
# openrouter | nvidia | ollama | lm_studio | mistral | together | fireworks | perplexity
# EMBEDDING_PROVIDER=

# ========================
# Supabase
# ========================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ========================
# LLM providers
# ========================

# ── OpenAI ─────────────────────────────────────────────
# Models: gpt-4o, gpt-4o-mini, o3, o4-mini, gpt-5.2, etc.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_LLM_MODEL=gpt-4o

# ── Gemini ─────────────────────────────────────────────
# Models: gemini-2.0-flash, gemini-2.5-flash, gemini-2.5-pro,
#         gemini-3.5-flash (when released)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_LLM_MODEL=gemini-2.0-flash

# ── Anthropic Claude ───────────────────────────────────
# Models: claude-sonnet-4-20250514, claude-opus-4-5, claude-haiku-3-5,
#         claude-sonnet-4-5, claude-opus-4-8
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_LLM_MODEL=claude-sonnet-4-20250514

# ── Groq ───────────────────────────────────────────────
# Models: llama-3.3-70b-versatile, llama-3.3-70b-specdec,
#         llama-4-70b, deepseek-r1-distill-llama-70b,
#         mixtral-8x7b-32768
GROQ_API_KEY=gsk-your-groq-api-key
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# ── Mistral ────────────────────────────────────────────
# Models: mistral-large-latest, mistral-small-latest,
#         codestral-latest, ministral-8b-latest
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_LLM_MODEL=mistral-large-latest

# ── Cohere ────────────────────────────────────────────
# Models: command-a-08-2025, command-r-08-2024,
#         command-r-plus-08-2024
COHERE_API_KEY=your-cohere-api-key
COHERE_LLM_MODEL=command-a-08-2025

# ── xAI / Grok ────────────────────────────────────────
# Models: grok-4.3, grok-4.4, grok-3-mini (reasoning),
#         grok-3-fast
XAI_API_KEY=your-xai-api-key
XAI_LLM_MODEL=grok-4.3

# ── Cerebras ──────────────────────────────────────────
# Models: llama-3.3-70b, llama-4-70b
CEREBRAS_API_KEY=your-cerebras-api-key
CEREBRAS_LLM_MODEL=llama-3.3-70b

# ── AWS Bedrock ───────────────────────────────────────
# Model ARN format: <region>.<provider>.<model>-v1:0
# Claude: us.anthropic.claude-sonnet-4-20250514-v1:0
#         us.anthropic.claude-opus-4-5-v1:0
# Llama:  us.meta.llama4-70b-instruct-v1:0
# Nova:   amazon.nova-pro-v1:0
# Titan:  amazon.titan-text-premier-v1:0
# Mistral: us.mistral.mistral-large-2407-v1:0
# DeepSeek: us.deepseek.r1-v1:0
BEDROCK_AWS_ACCESS_KEY_ID=
BEDROCK_AWS_SECRET_ACCESS_KEY=
# BEDROCK_AWS_SESSION_TOKEN=
BEDROCK_REGION_NAME=us-east-1
BEDROCK_LLM_MODEL=us.anthropic.claude-sonnet-4-20250514-v1:0

# ── OpenRouter (OpenAI-compatible) ────────────────────
# Models use "provider/model" format:
#   anthropic/claude-sonnet-4-20250514
#   openai/gpt-4o
#   google/gemini-2.0-flash
#   meta-llama/llama-4-70b-instruct
#   deepseek/deepseek-r1
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_LLM_MODEL=anthropic/claude-sonnet-4-20250514
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── NVIDIA (OpenAI-compatible) ────────────────────────
# Models: nvidia/llama-3.1-nemotron-70b-instruct,
#         mistralai/mixtral-8x22b-instruct-v0.1,
#         meta/llama4-70b
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Ollama (local, no API key needed) ─────────────────
# Any model you've pulled: llama3.2, llama3.3, mistral,
#   qwen2.5, deepseek-r1, phi4, gemma3, etc.
OLLAMA_LLM_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ── LM Studio (local, no API key needed) ──────────────
# The model name as shown in LM Studio's running server
# (usually matches the model path or display name)
LM_STUDIO_LLM_MODEL=local-model
# LM_STUDIO_BASE_URL=http://localhost:1234/v1

# ── Hugging Face (OpenAI-compatible) ──────────────────
# Models: meta-llama/Llama-3.2-3B-Instruct,
#         mistralai/Mistral-7B-Instruct-v0.3,
#         bigcode/starcoder2-15b-instruct-v0.1
HUGGINGFACE_API_KEY=hf-your-token
HUGGINGFACE_LLM_MODEL=meta-llama/Llama-3.2-3B-Instruct
# HUGGINGFACE_BASE_URL=https://api-inference.huggingface.co/v1

# ========================
# Embedding providers
# ========================

# ── OpenAI embeddings (default) ───────────────────────
# Models: text-embedding-3-small  (1536d, cheapest)
#         text-embedding-3-large  (3072d, best quality)
#         text-embedding-ada-002  (1536d, legacy)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# ── Gemini embeddings ─────────────────────────────────
# Models: gemini-embedding-001    (3072d)
#         gemini-embedding-2      (3072d, newer)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=3072

# ── Cohere embeddings ─────────────────────────────────
# Install: pip install document-copilot-backend[cohere]
# Models: embed-english-v3.0   (1024d, best English)
#         embed-multilingual-v3.0 (1024d, multilingual)
#         embed-english-light-v3.0 (384d, fast/cheap)
# Input types: search_document, search_query, classification, clustering
COHERE_EMBEDDING_MODEL=embed-english-v3.0
COHERE_EMBEDDING_INPUT_TYPE=search_document

# ── VoyageAI embeddings ───────────────────────────────
# Install: pip install document-copilot-backend[voyageai]
# Models: voyage-3-lite   (768d,  fast/cheap)
#         voyage-3        (1024d, balanced)
#         voyage-code-3   (1024d, code search)
#         voyage-finance-2 (1024d, finance domain)
#         voyage-law-2    (1024d, legal domain)
VOYAGEAI_API_KEY=your-voyageai-api-key
VOYAGEAI_EMBEDDING_MODEL=voyage-3-lite

# ── Sentence-Transformers (local) ─────────────────────
# Install: pip install document-copilot-backend[sentence-transformers]
# Downloads model on first use. Popular options:
#   all-MiniLM-L6-v2       (384d,  fast, good general-purpose)
#   all-mpnet-base-v2      (768d,  best quality)
#   BAAI/bge-small-en-v1.5 (384d,  good for retrieval)
#   intfloat/multilingual-e5-small (384d, multilingual)
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
SENTENCE_TRANSFORMER_DIMENSIONS=384

# ── Hugging Face embeddings (OpenAI-compatible) ──────
# Uses the Hugging Face Inference API /v1/embeddings endpoint.
# Models: sentence-transformers/all-MiniLM-L6-v2 (384d)
#         BAAI/bge-large-en-v1.5     (1024d)
#         BAAI/bge-small-en-v1.5     (384d)
#         intfloat/e5-mistral-7b-instruct (4096d)
#         thenlper/gte-large         (1024d)
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── OpenRouter embeddings (OpenAI-compatible) ────────
# Uses the OpenRouter /v1/embeddings endpoint.
# Models: openai/text-embedding-3-small   (1536d)
#         openai/text-embedding-3-large   (3072d)
#         google/gemini-embedding-001     (3072d)
#         qwen/qwen3-embedding-8b         (4096d)
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# ── NVIDIA embeddings (OpenAI-compatible) ────────────
# Uses the NVIDIA /v1/embeddings endpoint.
# Models: nvidia/nv-embedqa-e5-v5         (1024d)
#         nvidia/nv-embed-v1              (4096d)
#         nvidia/llama-nemotron-embed-1b-v2
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# ── Ollama embeddings (OpenAI-compatible, local) ─────
# Uses the Ollama /v1/embeddings endpoint (OpenAI-compatible).
# Models: nomic-embed-text:v1.5           (768d)
#         mxbai-embed-large               (1024d)
#         bge-m3                          (1024d, multilingual)
#         all-minilm:l6-v2                (384d, lightweight)
#         qwen3-embedding:8b              (up to 4096d)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:v1.5

# ── LM Studio embeddings (OpenAI-compatible, local) ──
# Uses the LM Studio /v1/embeddings endpoint (local inference server).
# The model name is whatever the loaded model filename is.
# Examples: nomic-embed-text-v1.5, bge-m3
LM_STUDIO_EMBEDDING_MODEL=nomic-embed-text-v1.5

# ── Mistral embeddings (native SDK) ──────────────────
# Uses the Mistral AI native SDK. The API uses `inputs` (not `input`)
# so it is NOT OpenAI-compatible.
# Models: mistral-embed                 (1024d, text)
#         codestral-embed-2505          (256–4096d, code)
MISTRAL_EMBEDDING_MODEL=mistral-embed

# ── Together AI embeddings (OpenAI-compatible) ──────
# Uses the Together AI /v1/embeddings endpoint.
# Models: togethercomputer/m2-bert-80M-8k-retrieval  (768d)
#         WhereIsAI/UAE-Large-V1                     (1024d)
#         BAAI/bge-large-en-v1.5                     (1024d)
#         intfloat/multilingual-e5-large-instruct    (1024d)
TOGETHER_API_KEY=
TOGETHER_EMBEDDING_MODEL=togethercomputer/m2-bert-80M-8k-retrieval

# ── Fireworks AI embeddings (OpenAI-compatible) ─────
# Uses the Fireworks AI /v1/embeddings endpoint.
# Models: nomic-ai/nomic-embed-text-v1.5  (768d)
#         fireworks/qwen3-embedding-8b     (up to 4096d)
#         fireworks/qwen3-embedding-4b
#         fireworks/qwen3-embedding-0p6b
FIREWORKS_API_KEY=
FIREWORKS_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# ── Perplexity embeddings (base64-encoded) ──────────
# Uses the Perplexity /v1/embeddings endpoint.
# Returns base64-encoded int8 vectors (decoded to float internally).
# Models: pplx-embed-v1-0.6b             (1024d)
#         pplx-embed-v1-4b               (2560d)
#         pplx-embed-context-v1-0.6b     (1024d, contextual)
#         pplx-embed-context-v1-4b       (2560d, contextual)
PERPLEXITY_API_KEY=
PERPLEXITY_EMBEDDING_MODEL=pplx-embed-v1-4b

# ── AWS Bedrock embeddings ────────────────────────────
# Install: pip install document-copilot-backend[bedrock]
# Models: amazon.titan-embed-text-v2:0    (1024d, text)
#         amazon.titan-embed-image-v1:0   (1024d, multimodal)
#         cohere.embed-english-v3:0       (1024d)
#         cohere.embed-multilingual-v3:0  (1024d)
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# ========================
# Docker (optional overrides)
# ========================
DATABASE_URL=postgresql://postgres:postgres@db:5432/document_copilot
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000
